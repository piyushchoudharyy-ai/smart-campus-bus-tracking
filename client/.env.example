# ===================================================================
# Smart Campus Bus Tracking System - Frontend Environment Configuration
# ===================================================================

# Public API Base URL
# - Local development / unified deployment: /api
# - Decoupled production (e.g. Vercel/Netlify pointing to external backend):
#   VITE_API_URL=https://your-campus-api.onrender.com/api
VITE_API_URL=/api

# WebSocket Gateway URL
# - Local development / unified deployment: leave blank to auto-connect to current origin
# - Decoupled production:
#   VITE_SOCKET_URL=https://your-campus-api.onrender.com
VITE_SOCKET_URL=
