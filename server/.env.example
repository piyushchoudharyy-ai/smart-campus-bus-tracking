# ===================================================================
# Smart Campus Bus Tracking System - Backend Environment Configuration
# ===================================================================

# Network Binding: 0.0.0.0 binds to all network interfaces (required for Docker, Render, Railway, AWS, Fly.io)
HOST=0.0.0.0
PORT=5000

# Environment Mode: 'production' or 'development'
NODE_ENV=production

# Security: Strong random secret for signing and verifying authentication tokens (JWT)
JWT_SECRET=replace_with_a_secure_random_key_for_production_min_32_characters!

# CORS Origins: Comma-separated list of allowed frontend domains or '*' for open access
# Example: https://your-campus-bus.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Database: Path to SQLite database file (automatically created on first launch)
DB_PATH=./campus_bus.db
